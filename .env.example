# --- Core ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/repairshop?retryWrites=true&w=majority

# --- Auth.js --- generate with: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Seed (pnpm seed): the first owner account. Only used when no user with this email exists. ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM="Repair Shop <bookings@example.com>"

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Spam protection (Cloudflare Turnstile + Upstash rate limit) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google reviews ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
# 32-byte key (base64 or hex) used to encrypt OAuth tokens and 2FA secrets at rest: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Analytics ---
NEXT_PUBLIC_GA_ID=

# --- Cron (Vercel sends this as a Bearer token to /api/cron/*) ---
CRON_SECRET=

# --- Error reporting (optional) ---
SENTRY_DSN=

# --- Shop defaults used until the owner saves Settings in admin ---
SHOP_TIMEZONE=Asia/Dhaka
SHOP_CURRENCY=BDT
ALERT_EMAIL=

# Older names still read as fallbacks: EMAIL_FROM, OWNER_EMAIL, OWNER_PASSWORD,
# NEXT_PUBLIC_GA4_ID, NEXT_PUBLIC_TURNSTILE_SITE_KEY.
