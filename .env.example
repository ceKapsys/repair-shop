# --- Core ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/repairshop?retryWrites=true&w=majority

# --- Auth.js --- generate with: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Seed (pnpm seed) ---
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="911 Mobile Repair Shop <bookings@example.com>"

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Spam protection ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google reviews ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
# 32-byte key used to encrypt OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=

# --- Analytics ---
NEXT_PUBLIC_GA4_ID=

# --- Shop defaults (overridden by admin Settings) ---
SHOP_TIMEZONE=UTC
SHOP_CURRENCY=USD
ALERT_EMAIL=

# --- Vercel cron auth ---
CRON_SECRET=
